a,discountRate:h,currencyPrice:y,currencySymbol:g,isForeignDiscount:a,ladderLevel:a,discountPrice:x,extPrice:"11.70",isRealOff:b},{ladder:q,productPrice:z,usdPrice:A,cnyProductPriceList:a,discountRate:h,currencyPrice:A,currencySymbol:g,isForeignDiscount:a,ladderLevel:a,discountPrice:z,extPrice:"37.00",isRealOff:b},{ladder:50000,productPrice:B,usdPrice:C,cnyProductPriceList:a,discountRate:h,currencyPrice:C,currencySymbol:g,isForeignDiscount:a,ladderLevel:a,discountPrice:B,extPrice:"175.00",isRealOff:b}],productImages:["https:\u002F\u002Fassets.lcsc.com\u002Fimages\u002Flcsc\u002F900x900\u002F20221227_Samsung-Electro-Mechanics-CL05B104KO5NNNC_C1525_front.jpg","https:\u002F\u002Fassets.lcsc.com\u002Fimages\u002Flcsc\u002F900x900\u002F20221227_Samsung-Electro-Mechanics-CL05B104KO5NNNC_C1525_back.jpg","https:\u002F\u002Fassets.lcsc.com\u002Fimages\u002Flcsc\u002F900x900\u002F20221227_Samsung-Electro-Mechanics-CL05B104KO5NNNC_C1525_blank.jpg"],edaSvgInfo:{schSvg:"\u002F\u002Fimage.easyeda.com\u002Fcomponent_svgs\u002Fprod\u002Fca94110f4544769d36adda4b0515e409.svg?t=1723686711",pcbSvg:"\u002F\u002Fimage.easyeda.com\u002Fcomponent_svgs\u002Fprod\u002F0821ed6ea50c44f4909e4be7610e4198.svg?t=1723686711"},faqs:[{question:"What Is the Minimum Ordering Quantity and Packaging Format?",answer:"The minimum order quantity on LCSC is 100 pieces, which is distributed on Cut Tape. For large-scale automated assembly, full factory LCSC-Reels are available containing a standard packaging quantity of 10,000 pieces."},{question:"Is This Component Environmentally Compliant?",answer:"Yes, this ceramic capacitor is fully RoHS compliant, meaning it meets strict international environmental regulations limiting the use of hazardous substances like lead."},{question:"What Is the Physical Package Size of This Component?",answer:"This capacitor comes in an 0402 surface-mount (SMD) package format, which measures approximately 1.0mm × 0.5mm (0.04 inches × 0.02 inches). Its tiny footprint makes it perfect for space-constrained PCB designs."},{question:"What Does the \"x7r\" Temperature Coefficient Mean?",answer:"X7R is a EIA temperature coefficient code indicating that the capacitor has an operating temperature range of -55°C to +125°C, with a maximum capacitance variation of ±15% over that entire range. This makes it highly stable for standard decoupling and filtering applications."},{question:"What Are the Main Capacitance and Voltage Specifications for This Capacitor?",answer:"The CL05B104KO5NNNC | Samsung Electro-Mechanics | Price | In Stock | LCSC Electronics has a capacitance value of 100nF (0.1µF) with a tolerance of ±10%, and it is rated for a maximum voltage of 16V."}],pdfUrl:k,productDescEn:D,productIntroEn:D,paramVOList:[{paramCode:"param_10951_n",paramName:"容值",paramNameEn:"Capacitance",paramValue:E,paramValueEn:E,paramValueEnForSearch:100000,isMain:c,sortNumber:i,sort:i},{paramCode:"param_10927",paramName:"温度系数",paramNameEn:"Temperature Coefficient",paramValue:F,paramValueEn:F,paramValueEnForSearch:p,isMain:c,sortNumber:i,sort:4},{paramCode:"param_10923_s",paramName:"精度",paramNameEn:"Tolerance",paramValue:G,paramValueEn:G,paramValueEnForSearch:a,isMain:c,sortNumber:i,sort:2},{paramCode:"param_10924_n",paramName:"额定电压",paramNameEn:"Voltage Rating",paramValue:H,paramValueEn:H,paramValueEnForSearch:16,isMain:c,sortNumber:i,sort:r}],wmCatalogId:n,wmCatalogNameEn:o,productArrange:"Tape & Reel (TR)",productWeight:.0000232,foreignWeight:.000013,isForeignOnsale:c,isForeignDisplay:c,isNotOverstock:b,productCycle:"normal",isHasBattery:b,pdfLinkUrl:a,isShowForeignPrice:c,isRealPrice:c,productLadderPrice:a,ladderDiscountRate:a,eccn:"EAR99",currencyType:"USD",currencySymbol:g,title:"Samsung Electro-Mechanics CL05B104KO5NNNC",weight:.013,hasThirdPartyStock:b,flashSaleProductPO:a,htsMap:{BR:"85322410",TARIC:"8532240000",IN:"85322400",CN:"8532241000",MX:"8532.24.01",CA:"8532240090",US:"8532240020"},isAsianBrand:a,isMro:b,isInfringement:b}}],fetch:[],error:a,state:{us