(footprint "VEMD10940F_SideView"
  (version 20240108)
  (generator pcbnew)
  (layer "F.Cu")
  (descr "Vishay VEMD10940FX01 side-view PIN photodiode, 3.0 x 2.0 x 1.0 mm; land geometry cross-checked against LCSC C7104273; pad 2 is non-electrical reinforcement")
  (tags "photodiode IR side view VEMD10940F")
  (property "Datasheet" "${KIPRJMOD}/../../docs/datasheets/VEMD10940FX01.pdf")
  (property "Description" "920 nm side-view silicon PIN photodiode with 830-950 nm daylight-blocking filter; pad 2 is a non-electrical reinforcement.")
  (attr smd)
  (fp_poly
    (pts (xy -1.5 -0.75) (xy -1.25 -1.0) (xy 1.5 -1.0)
         (xy 1.5 1.0) (xy -1.5 1.0))
    (stroke (width 0.10) (type default)) (fill none) (layer "F.Fab"))
  (fp_rect (start -2.8 -1.35) (end 2.8 1.25)
    (stroke (width 0.05) (type default)) (fill none) (layer "F.CrtYd"))
  (fp_line (start -1.4 1.0) (end 1.4 1.0)
    (stroke (width 0.15) (type default)) (layer "F.SilkS"))
  (fp_line (start -0.75 -1.0) (end 0.75 -1.0)
    (stroke (width 0.15) (type default)) (layer "F.SilkS"))
  (fp_poly
    (pts (xy -1.65 -1.25) (xy -1.35 -1.25) (xy -1.65 -0.95))
    (stroke (width 0.12) (type default)) (fill none) (layer "F.SilkS"))
  (fp_circle (center -1.15 -0.65) (end -1.05 -0.65)
    (stroke (width 0.10) (type default)) (fill none) (layer "F.Fab"))
  (fp_text reference "REF**" (at 0 -2) (layer "F.SilkS")
    (effects (font (size 0.8 0.8) (thickness 0.12))))
  (fp_text value "VEMD10940FX01" (at 0 2) (layer "F.Fab")
    (effects (font (size 0.8 0.8) (thickness 0.12))))
  (fp_text user "${REFERENCE}" (at 0 0) (layer "F.Fab")
    (effects (font (size 0.65 0.65) (thickness 0.10))))
  (pad "1" smd roundrect (at -1.75 -0.325) (size 1.5 1.5)
    (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.15))
  (pad "2" smd roundrect (at 0 0.325) (size 0.9 0.9)
    (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.15))
  (pad "3" smd roundrect (at 1.75 -0.325) (size 1.524 1.524)
    (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.15))
  (model "${KIPRJMOD}/IR_Spoke_Link.3dshapes/VEMD10940FX01.step"
